# Sysible Linux Operations Platform (SLOP) — gateway.
#
# One front door for the three Sysible apps, with REAL unified single sign-on
# (CE). A user signs in ONCE at the SLOP IdP; the gateway then proves their
# identity to each app so none of them shows its own login.
#
# Everything lives on ONE origin, addressed by PATH, on whatever IP this server
# has — no domain, no subdomains, no /etc/hosts, nothing to configure. Reach it at
# https://<server-ip>/ :
#
#   Portal        https://<server-ip>/                (requires sign-in)
#   Sign in       https://<server-ip>/login
#   Your account  https://<server-ip>/account         (change your password)
#   Accounts      https://<server-ip>/admin           (superuser: users + resets)
#   Controller    https://<server-ip>/controller/
#   SLEP          https://<server-ip>/slep/
#   Connect       https://<server-ip>/connect/
#
# TLS is a self-signed cert Caddy mints itself (see the cert-holder site below), so
# the browser shows the usual one-time "not trusted" warning — click through. Want a
# trusted cert / a name? Point external DNS at this IP and drop a real cert in front;
# nothing in here needs to know the address.
#
# How SSO works (full contract in ../docs/SSO.md):
#   1. The IdP (this repo's idp/ service) owns the user store and issues a
#      host-only session cookie on this one origin, so a single login is visible
#      to every /controller /slep /connect path.
#   2. On each proxied request the gateway asks the IdP "is this signed in?"
#      (forward_auth -> /auth/verify). On success it injects the caller's
#      identity to the upstream app as X-Sysible-User / X-Sysible-Role, plus a
#      shared-secret header X-Sysible-Auth that proves the request came through
#      the gateway. The apps trust the identity ONLY when that secret matches
#      (each app runs with SYSIBLE_SSO_SHARED_SECRET + its own trust flag).
#   3. Any client-supplied X-Sysible-* is STRIPPED before forward_auth, so a
#      browser can never forge an identity — only the gateway can set them.
{
	admin off
	log {
		output stdout
		format console
	}
	# There is NO configured domain. SLOP answers on 443 for whatever address the
	# client uses — the server's IP, straight up. To make TLS work without knowing
	# that IP ahead of time, Caddy mints one self-signed cert under a fixed internal
	# name (the cert-holder site below) and serves it for every connection whose SNI
	# doesn't match — i.e. every raw-IP request. default_sni selects that cert.
	default_sni sysible.slop
}

# ---- SSO for a fronted app, mounted under a PATH prefix --------------------
# Imported by the site once per app:  import appsite <prefix> <upstream-url>
#   {args[0]} = the URL path prefix (e.g. /controller)
#   {args[1]} = the app's upstream (host:port)
# Steps run in written order: match the prefix -> strip forged identity ->
# forward_auth (sets real identity, redirect to /login on miss) -> stamp the
# shared secret -> strip the prefix -> proxy to the app (which serves at root).
(appsite) {
	handle {args[0]}/* {
		route {
			# 1) A client must never be able to assert its own identity.
			request_header -X-Sysible-User
			request_header -X-Sysible-Role
			request_header -X-Sysible-Auth

			# 2) Ask the IdP whether this browser is signed in. On 401/403 bounce to
			#    the portal login with next= back to where they were headed. {uri}
			#    still carries the /controller-style prefix here (the strip below runs
			#    AFTER this), so login returns them to the right app path. On success,
			#    copy the asserted identity onto the upstream request.
			forward_auth {$SLOP_IDP_UPSTREAM:idp:8080} {
				uri /auth/verify
				copy_headers X-Sysible-User X-Sysible-Role
				@sso_bad status 401 403
				handle_response @sso_bad {
					redir /login?next={uri} 302
				}
			}

			# 3) Prove to the app that this request really came through the gateway.
			request_header X-Sysible-Auth {$SYSIBLE_SSO_SHARED_SECRET}

			# 4) Drop the prefix so the app sees its own root paths (/, /api, /assets,
			#    websockets). The app's front end was built with this prefix as its
			#    base, so the browser requests /controller/assets/... which becomes
			#    /assets/... here — the app itself needs no path awareness.
			uri strip_prefix {args[0]}

			# 5) Hand off to the app (unchanged, on its own port).
			reverse_proxy {args[1]} {
				transport http {
					# CE ships self-signed app certs, so the gateway can't verify the
					# upstream cert. RESIDUAL RISK: an attacker able to interpose on the
					# gateway->app hop (win a bind race on the app port, spoof
					# host.docker.internal) can stand up a rogue TLS listener and capture
					# X-Sysible-Auth, then forge any identity directly at the app port.
					# EE fix: put the gateway + apps on a private network and verify the
					# upstream (tls_trusted_ca_cert_file + tls_server_name / mTLS), or
					# remove the untrusted network path. Do NOT drop this in CE — the
					# self-signed apps would fail the handshake and the gateway would break.
					tls_insecure_skip_verify
				}
				header_up X-Forwarded-Proto https
				# Forward the browser-facing host so each app sees the real public origin
				# as its Host. Without this the app receives the upstream dial host
				# (host.docker.internal:PORT) and its same-origin CSRF/origin guard
				# rejects legitimate same-origin POSTs as "cross-origin".
				header_up Host {host}
				# Strip ONLY the IdP session cookie before forwarding, so a leaky/logging/
				# compromised app never receives — and cannot replay — a live SSO session
				# token (session-cookie replay / lateral movement). Find-and-replace form
				# removes just the sysible_sso pair; the apps' OWN cookies (sysible_web,
				# sysible_connect_session) ride the same request and are left intact.
				header_up Cookie "sysible_sso=[^;]*;?\s*" ""
			}
		}
	}
}

# ---- same as (appsite), but for a PLAIN-HTTP upstream ----------------------
# Identical SSO gate + prefix strip + cookie strip as (appsite); the only
# difference is the upstream speaks plain HTTP inside the private network (e.g.
# Flashback), so there is no upstream TLS to skip-verify. Same trust boundary: the
# gateway strips any client X-Sysible-*, injects identity only from the IdP, and
# stamps the shared secret AFTER auth. The gateway->app hop is still on the trusted
# internal network; publish the app port only where that hop can't be interposed.
(appsite_http) {
	handle {args[0]}/* {
		route {
			request_header -X-Sysible-User
			request_header -X-Sysible-Role
			request_header -X-Sysible-Auth
			forward_auth {$SLOP_IDP_UPSTREAM:idp:8080} {
				uri /auth/verify
				copy_headers X-Sysible-User X-Sysible-Role
				@sso_bad status 401 403
				handle_response @sso_bad {
					redir /login?next={uri} 302
				}
			}
			request_header X-Sysible-Auth {$SYSIBLE_SSO_SHARED_SECRET}
			uri strip_prefix {args[0]}
			reverse_proxy {args[1]} {
				header_up X-Forwarded-Proto https
				header_up Host {host}
				header_up Cookie "sysible_sso=[^;]*;?\s*" ""
			}
		}
	}
}

# ---- plain HTTP: bounce to HTTPS -------------------------------------------
# The real site below is host-less :443 (raw-IP), and Caddy only auto-creates an
# HTTP->HTTPS redirect per NAMED host — so without this a plain http://<ip>/ hit
# would have no handler. Redirect every :80 request to the same URL on https.
:80 {
	redir https://{host}{uri} permanent
}

# ---- cert holder: mint ONE self-signed cert, no domain needed ---------------
# This tiny site exists only so Caddy's internal CA issues a self-signed cert under
# a fixed internal name. It is never browsed to; default_sni (above) serves this
# cert for every raw-IP / no-SNI request to the real site below. Unique per install
# (lives in the slop-caddy-data volume), so there is nothing to configure and no
# shared key across installs.
sysible.slop {
	tls internal
	respond 204
}

# ---- the one front door: IdP + portal + the three apps, all by path ---------
# Catch-all on :443 — SLOP answers for ANY host/IP the client uses, with the
# self-signed cert from the holder above. No domain, no SLOP_DOMAIN: reach it at
# https://<this server's IP>/ (accept the one-time self-signed warning). Point
# external DNS at the IP if you want a name; nothing here needs to know about it.
:443 {
	encode gzip

	# Security headers on EVERY response from this origin. The single-origin SLOP
	# model collapses isolation between the portal, the three apps, and the admin
	# IdP, so these platform-wide defenses matter more here than usual:
	#   - frame-ancestors 'none' + X-Frame-Options: nothing may frame any SLOP page,
	#     so the destructive IdP admin forms can't be clickjacked. The apps open in
	#     new tabs (never iframes), so this breaks nothing.
	#   - nosniff: no MIME-sniffing an upload/response into executable script.
	#   - Referrer-Policy: never leak the path (which app / which account) off-site.
	#   - HSTS: inert for the raw-IP / self-signed default (browsers ignore HSTS for
	#     IP hosts and untrusted certs) but protects real-name / real-cert installs.
	# A restrictive default-src is deliberately NOT forced here — the three fronted
	# apps are SPAs with their own resource needs; each ships its own CSP, and the
	# IdP adds a strict one to its own pages. Multiple CSP headers intersect, so the
	# frame-ancestors below is enforced regardless of an app's own policy.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The IdP UI + API. These are PUBLIC at the gateway (the IdP itself enforces
	# session/role on /account and /admin, and /login must be reachable when
	# signed out). No forward_auth here, or you couldn't reach the login page.
	handle /auth/* {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	handle /login {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	handle /logout {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	# Exact path + own subtree only — a loose /account* suffix would also match an
	# unrelated /accountsomething. The IdP serves /account, /account/password,
	# /admin, and /admin/... (users, settings), all covered by these two pairs.
	handle /account {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	handle /account/* {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	handle /admin {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}
	handle /admin/* {
		reverse_proxy {$SLOP_IDP_UPSTREAM:idp:8080}
	}

	# Live health for the portal dots. Proxied same-origin so the browser never
	# reaches the app hosts directly (and CORS is a non-issue). Public (up/down
	# only, no sensitive data) so the dots can render before/around login. Each
	# proxy strips the IdP session cookie (sysible_sso) so the browser's SSO token
	# is never exposed to an app host on this path; tls_insecure_skip_verify
	# carries the same CE residual risk documented on the (appsite) hop above.
	handle /healthz/controller {
		rewrite * /api/health
		reverse_proxy https://{$SLOP_CONTROLLER_UPSTREAM:host.docker.internal:8800} {
			transport http {
				tls_insecure_skip_verify
			}
			header_up Cookie "sysible_sso=[^;]*;?\s*" ""
		}
	}
	handle /healthz/slep {
		rewrite * /api/health
		reverse_proxy https://{$SLOP_SLEP_UPSTREAM:host.docker.internal:8810} {
			transport http {
				tls_insecure_skip_verify
			}
			header_up Cookie "sysible_sso=[^;]*;?\s*" ""
		}
	}
	handle /healthz/connect {
		rewrite * /healthz
		reverse_proxy https://{$SLOP_CONNECT_UPSTREAM:host.docker.internal:8700} {
			transport http {
				tls_insecure_skip_verify
			}
			header_up Cookie "sysible_sso=[^;]*;?\s*" ""
		}
	}
	# Flashback serves plain HTTP inside the private network (TLS is the gateway's
	# job), so this hop is http:// — no upstream cert to skip-verify.
	handle /healthz/flashback {
		rewrite * /api/health
		reverse_proxy http://{$SLOP_FLASHBACK_UPSTREAM:host.docker.internal:8720} {
			header_up Cookie "sysible_sso=[^;]*;?\s*" ""
		}
	}

	# The three apps, each SSO-gated and prefix-stripped (see the appsite snippet).
	import appsite /controller https://{$SLOP_CONTROLLER_UPSTREAM:host.docker.internal:8800}
	import appsite /slep https://{$SLOP_SLEP_UPSTREAM:host.docker.internal:8810}
	import appsite /connect https://{$SLOP_CONNECT_UPSTREAM:host.docker.internal:8700}
	# Flashback (the config time machine) — plain HTTP upstream (see /healthz/flashback).
	import appsite_http /flashback http://{$SLOP_FLASHBACK_UPSTREAM:host.docker.internal:8720}

	# The portal itself (root) — require sign-in, then serve the static launcher.
	handle {
		route {
			request_header -X-Sysible-User
			request_header -X-Sysible-Role
			request_header -X-Sysible-Auth
			forward_auth {$SLOP_IDP_UPSTREAM:idp:8080} {
				uri /auth/verify
				@portal_bad status 401 403
				handle_response @portal_bad {
					redir /login?next={uri} 302
				}
			}
			root * /srv/portal
			file_server
		}
	}
}
