# Copy to .env and adjust. All values have working defaults for a single-host LAN.

# The domain the portal + app subdomains answer on. Point DNS (or every client's
# /etc/hosts) at this host for the apex AND the three subdomains, e.g.:
#   192.168.8.10   slop.lan controller.slop.lan slep.slop.lan connect.slop.lan
SLOP_DOMAIN=slop.lan

# Where each app actually listens (host:port). Defaults assume the apps publish
# their ports on this same host (as install-sysible / sysible_ctl bring them up).
# Change these if an app runs on another host or a shared docker network.
SLOP_CONTROLLER_UPSTREAM=host.docker.internal:8800
SLOP_SLEP_UPSTREAM=host.docker.internal:8810
SLOP_CONNECT_UPSTREAM=host.docker.internal:8700
