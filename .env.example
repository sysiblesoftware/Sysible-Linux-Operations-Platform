# Copy to .env and adjust. All values have working defaults for a single-host LAN.

# The domain the portal + app subdomains answer on. Point DNS (or every client's
# /etc/hosts) at this host for the apex AND the three subdomains, e.g.:
#   192.168.8.10   slop.lan controller.slop.lan slep.slop.lan connect.slop.lan
SLOP_DOMAIN=slop.lan

# ---- Single sign-on (unified login for all three apps) --------------------
# The shared secret the gateway stamps on requests it proxies, so each app can
# prove a request came through the gateway before trusting the asserted identity.
# It MUST be identical here and in every app's SYSIBLE_SSO_SHARED_SECRET.
# `install.sh` generates a strong one into your .env automatically; to bring the
# stack up by hand, set it yourself, e.g.:
#   SYSIBLE_SSO_SHARED_SECRET=$(openssl rand -hex 32)
SYSIBLE_SSO_SHARED_SECRET=

# First-run admin for the IdP. Leave the password empty to have a random one
# generated and printed ONCE to the idp logs (docker logs sysible-slop-idp);
# you'll be asked to change it at first login either way.
SLOP_ADMIN_USER=admin
SLOP_ADMIN_PASSWORD=

# ---- App upstreams --------------------------------------------------------
# Where each app actually listens (host:port). Defaults assume the apps publish
# their ports on this same host (as install-sysible / sysible_ctl bring them up).
# Change these if an app runs on another host or a shared docker network.
SLOP_CONTROLLER_UPSTREAM=host.docker.internal:8800
SLOP_SLEP_UPSTREAM=host.docker.internal:8810
SLOP_CONNECT_UPSTREAM=host.docker.internal:8700
