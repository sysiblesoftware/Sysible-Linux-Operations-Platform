# Copy to .env and adjust. All values have working defaults for a single-host LAN.
#
# There is NO domain to set. SLOP answers on 443 for whatever IP this server has —
# reach it at https://<server-ip>/ (accept the one-time self-signed cert warning).
# Everything is ONE origin, addressed by path (/ portal, /controller /slep /connect),
# so there are no subdomains and nothing to add to DNS or /etc/hosts.

# ---- Single sign-on (unified login for all three apps) --------------------
# The shared secret the gateway stamps on requests it proxies, so each app can
# prove a request came through the gateway before trusting the asserted identity.
# It MUST be identical here and in every app's SYSIBLE_SSO_SHARED_SECRET.
# `install.sh` generates a strong one into your .env automatically; to bring the
# stack up by hand, set it yourself, e.g.:
#   SYSIBLE_SSO_SHARED_SECRET=$(openssl rand -hex 32)
SYSIBLE_SSO_SHARED_SECRET=

# First-run admin for the IdP.
#
# Left empty, SLOP ships with the documented default:  admin / sysible
# That is PUBLIC — every install has it until you change it, at /account.
#
# For anything reachable from outside, set this to the literal word `random`
# instead: a random password is generated and written to
# $SLOP_DATA_DIR/initial-password (mode 0600) inside the idp container, never to
# the log, and deleted the first time that account signs in. Read it with:
#   docker compose exec idp cat /data/initial-password
#
# Or just set your own here. SLOP_MIN_PASSWORD_LEN (10) applies to every password
# set afterwards, so a replacement has to be at least that long.
SLOP_ADMIN_USER=admin
SLOP_ADMIN_PASSWORD=

# ---- App upstreams --------------------------------------------------------
# Where each app actually listens (host:port). Defaults assume the apps publish
# their ports on this same host (as install-sysible / sysiblectl bring them up).
# Change these if an app runs on another host or a shared docker network.
# HOST:PORT, with no scheme. The gateway writes the scheme itself (see the
# appsite / appsite_http imports in gateway/Caddyfile), so a value like
# http://host:8810 becomes https://http://host:8810 and Caddy refuses to adapt
# the config — the gateway does not start, with an error that does not mention
# the scheme. The Visualizer reads the same variables and strips one if present.
SLOP_CONTROLLER_UPSTREAM=host.docker.internal:8800
SLOP_SLEP_UPSTREAM=host.docker.internal:8810
SLOP_CONNECT_UPSTREAM=host.docker.internal:8700
